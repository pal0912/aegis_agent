# AegisAgent Configuration Template
# Copy this file to .env and configure your environment-specific settings.

# Device Configuration (auto, cpu, cuda)
AEGIS_DEVICE=auto

# Detection Engine Thresholds
AEGIS_DETECTION_THRESHOLD=0.80
AEGIS_INTENT_SIMILARITY_THRESHOLD=0.35
AEGIS_ENABLE_HEURISTICS=true

# Audit Logging Path
AEGIS_AUDIT_LOG_FILE=aegis_audit.jsonl
