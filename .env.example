# =====================================================================
# AegisAgent V2 Configuration Template
# Copy this file to .env and customize your environment settings.
# =====================================================================

# --------------------------------------------------
# Compute & Acceleration Settings
# --------------------------------------------------
# Execution device for DeBERTa / Transformer models: 'auto', 'cpu', or 'cuda'
AEGIS_DEVICE=auto

# --------------------------------------------------
# Detection & Policy Gate Thresholds
# --------------------------------------------------
# DeBERTa prompt injection sensitivity threshold (0.0 to 1.0)
AEGIS_DETECTION_THRESHOLD=0.80

# Semantic intent alignment cosine similarity threshold (0.0 to 1.0)
AEGIS_INTENT_SIMILARITY_THRESHOLD=0.35

# Human-In-The-Loop (HITL) risk escalation threshold (0.0 to 1.0)
AEGIS_HITL_RISK_THRESHOLD=0.40

# Enable regex heuristic pre-filtering for fast exploit detection
AEGIS_ENABLE_HEURISTICS=true

# --------------------------------------------------
# Cryptographic Audit Ledger & Tamper Detection
# --------------------------------------------------
# Filepath for JSON Lines sequential audit records
AEGIS_AUDIT_LOG_FILE=aegis_audit.jsonl

# Secret key used for HMAC-SHA256 digital signatures on ledger blocks
AEGIS_LEDGER_SECRET=aegis-enterprise-ledger-secret-key-prod-2026

# --------------------------------------------------
# Non-Human Identity & Multi-Agent Mesh
# --------------------------------------------------
# Maximum sub-agent delegation depth hops (default: 3)
AEGIS_MAX_DELEGATION_DEPTH=3

# Maximum execution steps per autonomous agent workflow (default: 15)
AEGIS_MAX_WORKFLOW_STEPS=15

# Default delegation passport TTL in seconds (default: 300)
AEGIS_DELEGATION_TOKEN_TTL_SECONDS=300

# --------------------------------------------------
# Declarative Policy Engine Configuration
# --------------------------------------------------
# Optional path to custom YAML/JSON declarative policy file
# AEGIS_POLICY_CONFIG_PATH=policies/production_policy.yaml

# --------------------------------------------------
# Isolated Code Execution Sandbox
# --------------------------------------------------
# Hard process execution timeout for sandboxed Python execution (seconds)
AEGIS_SANDBOX_TIMEOUT_SECONDS=3.0

# --------------------------------------------------
# Reverse Proxy Gateway & API Service
# --------------------------------------------------
AEGIS_GATEWAY_HOST=0.0.0.0
AEGIS_GATEWAY_PORT=8000

# --------------------------------------------------
# Document Ingestion & Multimodal Settings
# --------------------------------------------------
AEGIS_INPUT_DOCUMENT=1NPDPRO5.DOC

# Upstream LLM Provider API Key (if proxying to external OpenAI / Anthropic APIs)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# HuggingFace Hub Token (for private model repos / authenticated downloads)
# HF_TOKEN=your-huggingface-token-here

