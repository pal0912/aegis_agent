{
  "$defs": {
    "AttemptValidity": {
      "description": "Validity of an individual scenario execution attempt.",
      "enum": [
        "VALID",
        "INVALID",
        "ERROR",
        "INCONCLUSIVE"
      ],
      "title": "AttemptValidity",
      "type": "string"
    },
    "BenignOutcome": {
      "description": "Intervention and utility outcome taxonomy for benign workloads.",
      "enum": [
        "NO_INTERVENTION",
        "RESTRICTED_BUT_SUCCESSFUL",
        "INAPPROPRIATE_BLOCK",
        "INAPPROPRIATE_QUARANTINE",
        "TASK_SUCCESS",
        "TASK_FAILURE",
        "INCONCLUSIVE"
      ],
      "title": "BenignOutcome",
      "type": "string"
    },
    "BlastRadiusLevel": {
      "description": "Aegis-specific blast-radius scoring level (0-6).",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "BlastRadiusLevel",
      "type": "integer"
    },
    "ControlActivationRecord": {
      "description": "Activation records across all 13 Aegis controls.",
      "properties": {
        "detector": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "sanitizer": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "provenance": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "memory_guard": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "capability_policy": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "dlp": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "network_guard": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "action_graph": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "consensus": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "circuit_breaker": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "mcp_guard": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "validation_scope": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        },
        "incident_response": {
          "$ref": "#/$defs/ControlState",
          "default": "NOT_TRIGGERED"
        }
      },
      "title": "ControlActivationRecord",
      "type": "object"
    },
    "ControlState": {
      "description": "Activation state of an individual security control during attempt.",
      "enum": [
        "NOT_TRIGGERED",
        "TRIGGERED",
        "BLOCKED",
        "FAILED",
        "BYPASSED",
        "NOT_APPLICABLE"
      ],
      "title": "ControlState",
      "type": "string"
    },
    "ExperimentalCondition": {
      "description": "Experimental condition under which an attempt executes.",
      "enum": [
        "BASELINE",
        "AEGIS_FULL",
        "AEGIS_NO_DETECTOR",
        "AEGIS_NO_PROVENANCE",
        "AEGIS_NO_DLP",
        "AEGIS_NO_CAPABILITY",
        "AEGIS_NO_NETWORK",
        "AEGIS_NO_ACTION_GRAPH",
        "AEGIS_NO_CONSENSUS",
        "AEGIS_NO_CANARY",
        "AEGIS_NO_MEMORY",
        "AEGIS_NO_CIRCUIT_BREAKER",
        "AEGIS_NO_SANITIZER",
        "AEGIS_NO_MCP_GUARD"
      ],
      "title": "ExperimentalCondition",
      "type": "string"
    },
    "IntermediateImpacts": {
      "description": "Explicit tracking of intermediate security impacts.",
      "properties": {
        "secret_accessed": {
          "default": false,
          "title": "Secret Accessed",
          "type": "boolean"
        },
        "unauthorized_tool_selected": {
          "default": false,
          "title": "Unauthorized Tool Selected",
          "type": "boolean"
        },
        "memory_modified": {
          "default": false,
          "title": "Memory Modified",
          "type": "boolean"
        },
        "capability_escalation_attempted": {
          "default": false,
          "title": "Capability Escalation Attempted",
          "type": "boolean"
        },
        "internal_resource_accessed": {
          "default": false,
          "title": "Internal Resource Accessed",
          "type": "boolean"
        }
      },
      "title": "IntermediateImpacts",
      "type": "object"
    },
    "ObjectiveStateTransition": {
      "description": "Objective state transition tracking stages of attack progression.",
      "properties": {
        "objective_started": {
          "default": false,
          "title": "Objective Started",
          "type": "boolean"
        },
        "objective_intermediate_state": {
          "default": false,
          "title": "Objective Intermediate State",
          "type": "boolean"
        },
        "objective_achieved": {
          "default": false,
          "title": "Objective Achieved",
          "type": "boolean"
        },
        "intermediate_impacts": {
          "$ref": "#/$defs/IntermediateImpacts"
        }
      },
      "title": "ObjectiveStateTransition",
      "type": "object"
    },
    "ObservableEvidence": {
      "description": "Observable sink and event evidence collected during an attempt.",
      "properties": {
        "filesystem_mutations": {
          "items": {
            "type": "string"
          },
          "title": "Filesystem Mutations",
          "type": "array"
        },
        "database_mutations": {
          "items": {
            "type": "string"
          },
          "title": "Database Mutations",
          "type": "array"
        },
        "network_egress_destinations": {
          "items": {
            "type": "string"
          },
          "title": "Network Egress Destinations",
          "type": "array"
        },
        "external_messages_sent": {
          "items": {
            "type": "string"
          },
          "title": "External Messages Sent",
          "type": "array"
        },
        "secrets_accessed": {
          "items": {
            "type": "string"
          },
          "title": "Secrets Accessed",
          "type": "array"
        },
        "secrets_exfiltrated": {
          "items": {
            "type": "string"
          },
          "title": "Secrets Exfiltrated",
          "type": "array"
        },
        "memory_modifications": {
          "items": {
            "type": "string"
          },
          "title": "Memory Modifications",
          "type": "array"
        },
        "tools_executed": {
          "items": {
            "type": "string"
          },
          "title": "Tools Executed",
          "type": "array"
        },
        "unauthorized_tool_calls_count": {
          "default": 0,
          "title": "Unauthorized Tool Calls Count",
          "type": "integer"
        },
        "unauthorized_data_transfers_count": {
          "default": 0,
          "title": "Unauthorized Data Transfers Count",
          "type": "integer"
        }
      },
      "title": "ObservableEvidence",
      "type": "object"
    },
    "ScenarioValidity": {
      "description": "Validity of a benchmark scenario definition.",
      "enum": [
        "VALID",
        "INVALID"
      ],
      "title": "ScenarioValidity",
      "type": "string"
    },
    "SecurityOutcome": {
      "description": "Final security outcome of a VALID adversarial attempt.\n\nNOTE: If AttemptValidity != VALID (e.g. ERROR, INCONCLUSIVE, INVALID)\nOR if the attempt is benign, SecurityOutcome MUST strictly be\nNOT_APPLICABLE.",
      "enum": [
        "NOT_APPLICABLE",
        "DETECTED",
        "BLOCKED",
        "CONTAINED",
        "PARTIALLY_CONTAINED",
        "EXECUTED",
        "EXFILTRATED"
      ],
      "title": "SecurityOutcome",
      "type": "string"
    }
  },
  "description": "Typed result of executing a scenario under a specific condition.",
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "condition": {
      "$ref": "#/$defs/ExperimentalCondition"
    },
    "scenario_validity": {
      "$ref": "#/$defs/ScenarioValidity"
    },
    "attempt_validity": {
      "$ref": "#/$defs/AttemptValidity"
    },
    "final_security_outcome": {
      "$ref": "#/$defs/SecurityOutcome",
      "default": "NOT_APPLICABLE"
    },
    "benign_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenignOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_successful": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Successful"
    },
    "objective_transition": {
      "$ref": "#/$defs/ObjectiveStateTransition"
    },
    "objective_achieved": {
      "default": false,
      "title": "Objective Achieved",
      "type": "boolean"
    },
    "measurement_complete": {
      "default": true,
      "title": "Measurement Complete",
      "type": "boolean"
    },
    "blast_radius": {
      "$ref": "#/$defs/BlastRadiusLevel",
      "default": 0
    },
    "evidence": {
      "$ref": "#/$defs/ObservableEvidence"
    },
    "controls": {
      "$ref": "#/$defs/ControlActivationRecord"
    },
    "latency_ms": {
      "default": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    }
  },
  "required": [
    "attempt_id",
    "scenario_id",
    "condition",
    "scenario_validity",
    "attempt_validity"
  ],
  "title": "AttemptResult",
  "type": "object"
}